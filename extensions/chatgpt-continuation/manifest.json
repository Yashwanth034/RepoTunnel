{
  "manifest_version": 3,
  "name": "RepoTunnel Continuation",
  "short_name": "RepoTunnel",
  "version": "0.4.1",
  "description": "Safely delivers RepoTunnel continuation checkpoints to exact saved ChatGPT conversations.",
  "minimum_chrome_version": "102",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:43185/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/c/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RepoTunnel Continuation",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
