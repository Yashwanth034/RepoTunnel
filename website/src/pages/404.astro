---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The requested RepoTunnel website page could not be found." noindex={true}>
  <section class="page-hero"><div class="narrow"><span class="eyebrow">404</span><h1>That page is not here</h1><p class="lead">Use the documentation search or return to the RepoTunnel home page.</p><div class="hero-actions"><a class="btn btn-accent" href="/">Home</a><button class="btn" data-action="search-open">Search docs</button></div></div></section>
</BaseLayout>
