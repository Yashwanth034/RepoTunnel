---
const { currentPath = '' } = Astro.props as { currentPath?: string };
const nav = [
  ['Product', '/product/'],
  ['Solutions', '/solutions/'],
  ['Docs', '/docs/'],
  ['Install', '/install/'],
  ['Security', '/security/']
];
const active = (href: string) => currentPath.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="RepoTunnel home">
      <span class="brand-symbol" aria-hidden="true">R</span>
      <span>RepoTunnel</span></a>
    <nav class="header-nav" aria-label="Main navigation">
      {nav.map(([label,href]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="icon-button" data-action="search-open" aria-label="Search" title="Search documentation">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m16 16 5 5"/></svg>
      </button>
      <button class="icon-button theme-button" data-action="theme" aria-label="Toggle color theme" title="Toggle color theme">
        <svg class="theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 15A8.8 8.8 0 0 1 9 4a8.8 8.8 0 1 0 11 11Z"/></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      {currentPath !== '/community/' && <a class="header-source" href="https://github.com/Yashwanth034/RepoTunnel" rel="noopener noreferrer">GitHub</a>}
      <button class="menu-button" data-action="menu" aria-label="Open navigation" aria-controls="site-mobile-nav" aria-expanded="false"><span></span><span></span></button>
    </div>
  </div>
</header>
<nav class="mobile-nav" id="site-mobile-nav" aria-label="Mobile navigation">
  {nav.map(([label,href]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
  <a href="/downloads/">Downloads</a>
  <a href="/changelog/">Changelog</a>
  {currentPath !== '/community/' && <a href="https://github.com/Yashwanth034/RepoTunnel">Source on GitHub</a>}
</nav>
