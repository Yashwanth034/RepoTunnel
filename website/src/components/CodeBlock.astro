---
interface Props { code: string; label?: string; }
const { code, label = 'Code example' } = Astro.props;
---
<div class="code-block">
  <div class="code-toolbar">
    <span class="code-label">Code</span>
    <button class="copy-button" type="button" data-action="copy" aria-label={`Copy code for ${label}`}><span class="copy-label" aria-live="polite">Copy</span></button>
  </div>
  <pre tabindex="0" role="region" aria-label={label}><code>{code}</code></pre>
</div>
