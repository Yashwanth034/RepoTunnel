<dialog class="search-dialog" id="site-search" aria-label="Search RepoTunnel website">
  <div class="search-head">
    <span aria-hidden="true">⌕</span>
    <input id="site-search-input" type="search" placeholder="Search pages" autocomplete="off" aria-label="Search pages" />
    <button class="icon-button" data-action="search-close" aria-label="Close search">×</button>
  </div>
  <div class="search-results" id="site-search-results" role="region" aria-live="polite" aria-label="Search results"><div class="search-empty">Start typing to search.</div></div>
</dialog>
